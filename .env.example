# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search API Configuration (Tùy chọn: nếu có Tavily để search internet thật)
TAVILY_API_KEY=

# Observability (Tùy chọn: nếu muốn stream trace lên LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-research-lab

# App Configuration
LOG_LEVEL=INFO
TIMEOUT_SECONDS=60
MAX_ITERATIONS=6
